{
  "name": "tokenstork",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite build",
    "preview": "vite preview",
    "start": "node build",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "sync:leaderboards": "tsx scripts/snapshot-leaderboards.ts",
    "typecheck": "tsc --noEmit --project scripts/tsconfig.json"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.0.0",
    "@internationalized/date": "^3.12.4",
    "@types/pg": "^8.23.1",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.25.0",
    "autoprefixer": "^10.6.1",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.8",
    "better-sqlite3": "^12.11.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "zeromq": "^6.8.0"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.2",
      "ws": ">=7.5.11",
      "esbuild": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "zeromq",
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "use-sync-external-store"
      ]
    }
  }
}
