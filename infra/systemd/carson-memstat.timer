[Unit]
Description=Sample carson memory headroom every minute for 7 days (PAN-182)
Documentation=https://github.com/Panmoni/tokenstork

[Timer]
# 1-min cadence: ~10k rows over the week, enough for a stable p95.
# Each run reads three /proc files and appends one line. After 7 days
# the service writes a done file and its ConditionPathExists skips every
# later tick; disable the timer once the summary is in.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s
Unit=carson-memstat.service

[Install]
WantedBy=timers.target
